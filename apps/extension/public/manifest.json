{
  "manifest_version": 3,
  "name": "Scam Shield",
  "short_name": "Scam Shield",
  "version": "0.1.0",
  "description": "Check messages, job offers and web pages for scams privately, with Gemini Nano on your own device.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Scam Shield: check privately",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "contextMenus", "activeTab", "scripting", "storage"]
}
