# Copy to .env.local (git-ignored) and fill in the Firebase web config of project "scamshield-hybrid".
# These are public web identifiers, but keep them out of the repo anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=scamshield-hybrid.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=scamshield-hybrid
VITE_FIREBASE_STORAGE_BUCKET=scamshield-hybrid.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA site key registered for App Check (web app) and its type: enterprise (default) or v3.
VITE_RECAPTCHA_SITE_KEY=
VITE_RECAPTCHA_PROVIDER=enterprise
# Optional: App Check debug token. Used ONLY in local dev (vite dev) and in the extension build;
# the hosted web build never contains it (see scripts/check-no-debug-token.mjs).
VITE_APPCHECK_DEBUG_TOKEN=
